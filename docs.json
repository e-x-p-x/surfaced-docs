            "group": "Content",
            "pages": ["content/briefs", "content/articles"]
          },
          {
            "group": "Publish",
            "pages": ["publish/hosted-blog", "publish/integrations"]
          },
          {
            "group": "Account",
            "pages": [
              "account/members-and-roles",
              "account/billing-and-usage",
              "account/referrals"
            ]
          },
          {
            "group": "Troubleshooting",
            "pages": ["troubleshooting/faq", "troubleshooting/common-issues"]
