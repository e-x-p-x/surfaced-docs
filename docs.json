{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Surfaced",
  "description": "How to set up Surfaced, read your AI-visibility results, and act on them.",
  "colors": {
    "primary": "#28030f",
    "light": "#f8ef32",
    "dark": "#f8ef32"
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "fonts": {
    "heading": {
      "family": "Geist",
      "weight": 800
    },
    "body": {
      "family": "Geist",
      "weight": 400
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://www.getsurfaced.ai"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "how-surfaced-collects-data",
              "app-map",
              "glossary"
            ]
          },
          {
            "group": "Set up",
            "pages": [
              "set-up/workspace",
              "set-up/prompts",
              "set-up/competitors",
              "set-up/markets-and-languages",
              "set-up/tracking-defaults"
            ]
          },
          {
            "group": "Metrics",
            "pages": [
              "metrics/overview",
              "metrics/brand-visibility",
              "metrics/citation-rate",
              "metrics/share-of-voice",
              "metrics/average-position",
              "metrics/sentiment",
              "metrics/audit-score",
              "metrics/periods-and-filters"
            ]
          },
          {
            "group": "Insights",
            "pages": [
